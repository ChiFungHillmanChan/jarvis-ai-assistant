{
  "productName": "JARVIS",
  "version": "0.5.13",
  "identifier": "com.jarvis.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "JARVIS",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#101317",
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Hillman Chan (22K6G3HH9G)"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://jarvis-automation.com/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENDc1MEE2RkFERjE0MTMKUldRVEZOLzZwbEJIdmJObzFNTnlxVlNxT2xGWU5ieUt0L2YrQURRN2VRaitsTS9ZUzJ3b0FpSWMK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "jarvis"
        ]
      }
    }
  }
}
